# HireFlow AI agent — model access.
#
# The agent routes (src/app/api/agent/*) call this endpoint server-side; the key
# never reaches the browser. Any OpenAI-compatible chat/completions endpoint works.
#
# Copy to .env.local for development, or set these in your hosting provider.
HIREFLOW_API_KEY=sk-your-key-here
# Use 127.0.0.1 rather than localhost for a v4-only local proxy.
HIREFLOW_BASE_URL=http://127.0.0.1:8082/v1
HIREFLOW_MODEL=opencode/muse-spark-1.3-contributor-free

# Optional: absolute base for Open Graph image URLs.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
