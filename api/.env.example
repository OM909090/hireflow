# Copy to .env and fill in. .env is gitignored.
#
# Note: use 127.0.0.1, not localhost — the local gateway binds IPv4 only and
# `localhost` resolves to ::1 first, which hangs instead of failing fast.
HIREFLOW_API_KEY=sk-test
HIREFLOW_BASE_URL=http://127.0.0.1:8082/v1

# Must be a model the gateway actually serves (see `GET /v1/models`).
# Anything unrecognised routes to a provider with no credentials and 404s.
HIREFLOW_MODEL=opencode/muse-spark-1.3-contributor-free
